# Environment secrets
.env
.env.*
!.env.example

# Python virtual environments
venv/
.venv/
__pycache__/
*.py[cod]

# Python testing and linting
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs and local databases
logs/
*.sqlite
*.sqlite3
*.db

# Operating system files
.DS_Store
Thumbs.db

# Full source-document collection stays local
/data/*

# Allow the sample folder and its PDF files
!/data/sample/
!/data/sample/*.pdf

# Allow the dataset manifest
!/data/manifest.csv

# Downloader output stays local
/data/raw/

# Python-generated page-count output
/data/page_counts.csv

# Discovered URL candidates (can be regenerated)
/data/discovered_urls.csv

# Annual and quarterly PDFs in the separate dataset directory
/dataset/**/*.pdf
