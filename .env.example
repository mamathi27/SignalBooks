APP_NAME=SignalBooks
ENVIRONMENT=local

# fake or openai_compatible
LLM_PROVIDER=fake

# OpenAI-compatible API settings
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_FALLBACK_MODEL=fake-fallback
LLM_TIMEOUT_SECONDS=30

# USD per million tokens (configure using your provider's published prices)
PRICE_INPUT_PER_MILLION=0.15
PRICE_OUTPUT_PER_MILLION=0.60

# Configurable conversion rate; not a live exchange rate
USD_TO_INR_RATE=85.0

# Usage estimation when provider token counts are missing
ESTIMATED_CHARS_PER_TOKEN=4
