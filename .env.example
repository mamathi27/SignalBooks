APP_NAME=SignalBooks
ENVIRONMENT=local

# LLM provider: fake or openai_compatible
LLM_PROVIDER=fake
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODEL=fake-fallback
LLM_TIMEOUT_SECONDS=30

# Configure actual provider pricing before relying on cost estimates.
PRICE_INPUT_PER_MILLION=0.0
PRICE_OUTPUT_PER_MILLION=0.0
USD_TO_INR_RATE=85.0
ESTIMATED_CHARS_PER_TOKEN=4

POSTGRES_DB=signalbooks
POSTGRES_USER=signalbooks
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://signalbooks:change-me@localhost:5432/signalbooks
